#!/usr/bin/env python3
"""The deterministic gate: does the job's branch pass the repo's checks?

Usage:
  gate <job>            write round-N/checks.md; exit 0 on PASS, 1 on FAIL
  gate <job> --merge    same, as round-N/merge-checks.md

The gate runs .centuria/checks.sh inside the job's worktree, so a branch can
never change the checks it is judged by. It also fails when the branch
modifies or deletes a file matching config.json `protected_paths`
(fnmatch patterns, where `*` also matches `/`). New files are fine.
"""

import fnmatch
import json
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
CENTURIA = REPO / ".centuria"
CONFIG = json.loads((CENTURIA / "config.json").read_text())
CHECKS = CENTURIA / "checks.sh"
TAIL = 80


def die(msg):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(2)


def git(worktree, *args):
    res = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True)
    if res.returncode != 0:
        die(f"`git {' '.join(args)}` failed: {res.stderr.strip()}")
    return res.stdout


def protected_changes(worktree):
    """Existing files under protected_paths that the branch changed or deleted."""
    diff = git(worktree, "diff", "--name-status",
               f"origin/{CONFIG['base_branch']}...HEAD")
    hits = []
    for line in diff.splitlines():
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        status, paths = parts[0], parts[1:]
        if status.startswith("A"):
            continue
        old = paths[0]
        if any(fnmatch.fnmatch(old, p) for p in CONFIG.get("protected_paths", [])):
            hits.append(f"{status[0]} {old}")
    return hits


def run_checks(worktree):
    if not CHECKS.exists():
        die(f"{CHECKS} is missing")
    start = time.monotonic()
    res = subprocess.run(["bash", str(CHECKS)], cwd=worktree,
                         capture_output=True, text=True)
    return res.returncode, res.stdout + res.stderr, int(time.monotonic() - start)


def gate(job_id, merge):
    job = json.loads((CENTURIA / "jobs" / job_id / "job.json").read_text())
    worktree = job["worktree"]
    if job["round"] < 1:
        die(f"{job_id} hasn't started a build round")
    round_dir = CENTURIA / "jobs" / job_id / f"round-{job['round']}"
    commit = git(worktree, "rev-parse", "HEAD").strip()
    protected = protected_changes(worktree)
    code, log, seconds = run_checks(worktree)
    verdict = "PASS" if code == 0 and not protected else "FAIL"
    name = "merge-checks" if merge else "checks"
    round_dir.mkdir(parents=True, exist_ok=True)
    (round_dir / f"{name}.log").write_text(log)
    tail = "\n".join(log.rstrip().splitlines()[-TAIL:])
    summary = [
        f"checks.sh {'passed' if code == 0 else f'failed with exit {code}'} in {seconds}s",
        f"Protected paths: {'changed: ' + ', '.join(protected) if protected else 'none changed'}",
        f"Commit {commit[:7]}" + (", synced with the latest base branch" if merge else ""),
    ]
    (round_dir / f"{name}.md").write_text(
        f"GATE: {verdict}\nCOMMIT: {commit}\n\n"
        "## Summary\n" + "\n".join(f"- {s}" for s in summary) + "\n\n"
        "## Protected paths\n"
        + ("\n".join(f"- {p}" for p in protected) if protected else "None changed.")
        + f"\n\n## checks.sh\nExit {code} in {seconds}s. "
          f"Last {TAIL} lines of {name}.log:\n\n```\n{tail}\n```\n")
    print(f"GATE: {verdict} ({job_id} round {job['round']}, "
          f"checks.sh exit {code} in {seconds}s"
          + (f", protected paths changed: {', '.join(protected)}" if protected else "") + ")")
    sys.exit(0 if verdict == "PASS" else 1)


def main(argv):
    if len(argv) == 1 and not argv[0].startswith("-"):
        gate(argv[0], merge=False)
    elif len(argv) == 2 and argv[1] == "--merge":
        gate(argv[0], merge=True)
    else:
        die(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
